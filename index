  drum:'<ellipse cx="0" cy="-6" rx="13" ry="4.5"/><path d="M-13,-6 L-13,6 Q0,12 13,6 L13,-6"/><path d="M-9,-3 L-4,6 L1,-3 L6,6 L11,-2"/><path d="M-11,-16 L-4,-9 M11,-16 L4,-9"/>'

};



/* ============ the rakhi ============ */

const SHAPES = {

  lotus:{o:"M0,-12 C19,-27 19,-55 0,-64 C-19,-55 -19,-27 0,-12 Z", i:"M0,-8 C12,-19 12,-38 0,-44 C-12,-38 -12,-19 0,-8 Z"},

  round:{o:"M0,-16 C23,-24 23,-52 0,-60 C-23,-52 -23,-24 0,-16 Z", i:"M0,-10 C15,-17 15,-36 0,-42 C-15,-36 -15,-17 0,-10 Z"},

  point:{o:"M0,-10 C13,-32 9,-54 0,-68 C-9,-54 -13,-32 0,-10 Z", i:"M0,-7 C9,-22 6,-38 0,-47 C-6,-38 -9,-22 0,-7 Z"},

  tear :{o:"M0,-14 C21,-25 16,-52 0,-63 C-16,-52 -21,-25 0,-14 Z", i:"M0,-9 C14,-18 10,-37 0,-44 C-10,-37 -14,-18 0,-9 Z"}

};



function buildRakhi(b){

  const sh = SHAPES[b.shape] || SHAPES.lotus, n = b.petals;

  let s = '<defs><radialGradient id="gold" cx="34%" cy="28%">'+

          '<stop offset="0%" stop-color="#FFF7D6"/><stop offset="52%" stop-color="#FFD268"/><stop offset="100%" stop-color="#B87A22"/>'+

          '</radialGradient></defs>';



  /* silk ends */

  s += '<g class="tasselSway">';

  [[-16,1],[16,-1]].forEach(([x,f],k)=>{

    s += '<g class="tassel" style="transition-delay:'+(60+k*70)+'ms">'+

         '<path d="M'+x+',30 C'+(x+10*f)+',66 '+(x-6*f)+',96 '+(x+8*f)+',126" stroke="'+b.accent2+'" stroke-width="3.6" fill="none" stroke-linecap="round"/>'+

         '<circle cx="'+(x+8*f)+'" cy="130" r="5.4" fill="url(#gold)"/></g>';

  });

  s += '</g>';



  /* silk base */

  s += '<circle class="base" r="58" fill="'+b.accent2+'" opacity="1" style="opacity:0"/>';



  /* outer petals */

  s += '<g class="outer" fill="'+b.accent+'">';

  for(let i=0;i<n;i++)

    s += '<g transform="rotate('+(i*360/n)+')"><path class="petal" style="transition-delay:'+(i*55)+'ms" d="'+sh.o+'"/></g>';

  s += '</g>';



  /* inner petals */

  s += '<g class="inner" fill="'+b.accent2+'" style="transform-origin:0 0">';

  for(let i=0;i<n;i++)

    s += '<g transform="rotate('+(i*360/n + 180/n)+')"><path class="petal" style="transition-delay:'+(i*45)+'ms" d="'+sh.i+'"/></g>';

  s += '</g>';



  /* gold beads */

  for(let i=0;i<18;i++){

    const a=i*20*Math.PI/180;

    s += '<circle class="bead" style="transition-delay:'+(i*28)+'ms" cx="'+(Math.cos(a)*78).toFixed(1)+'" cy="'+(Math.sin(a)*78).toFixed(1)+'" r="3.6" fill="url(#gold)"/>';

  }



  /* gold centre with his icon */

  s += '<g class="core">';

  s += '<circle r="34" fill="url(#gold)"/><circle r="34" fill="none" stroke="#7A4E11" stroke-width="1" opacity=".45"/>';

  for(let i=0;i<14;i++){

    const a=i*(360/14)*Math.PI/180;

    s += '<circle cx="'+(Math.cos(a)*34).toFixed(1)+'" cy="'+(Math.sin(a)*34).toFixed(1)+'" r="2.7" fill="#FFF7D6"/>';

  }

  s += '<circle r="27" fill="#17102F"/><circle r="27" fill="none" stroke="#FFD268" stroke-width="1" opacity=".6"/>';

  s += '<g stroke="#FFD268" stroke-width="1.9" fill="none" stroke-linecap="round" stroke-linejoin="round" transform="scale(.85)">'+ICONS[b.art]+'</g>';

  s += '</g>';



  return s;

}



/* ============ comic panel: sister tying the rakhi ============ */

function buildScene(b){

  const A=b.accent;

  let s='<defs><pattern id="dots" width="9" height="9" patternUnits="userSpaceOnUse">'+

        '<circle cx="2" cy="2" r="1.1" fill="'+A+'" opacity=".55"/></pattern></defs>';

  /* panel + halftone */

  s+='<rect x="8" y="8" width="304" height="204" rx="18" fill="url(#dots)" opacity=".5"/>';

  s+='<rect x="8" y="8" width="304" height="204" rx="18" fill="none" stroke="'+A+'" stroke-width="2"/>';

  /* speed lines behind */

  s+='<g stroke="'+A+'" stroke-width="1.6" opacity=".5">';

  [30,48,66].forEach((y,i)=>s+='<path d="M'+(24+i*8)+','+y+' L'+(92+i*10)+','+(y-6)+'"/>');

  [30,48,66].forEach((y,i)=>s+='<path d="M'+(296-i*8)+','+y+' L'+(228-i*10)+','+(y-6)+'"/>');

  s+='</g>';



  const g='<g fill="none" stroke="'+A+'" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">';

  /* sister, left, leaning in */

  s+=g+

    '<circle cx="96" cy="86" r="19"/>'+                        /* head */

    '<path d="M96,67 Q78,72 80,96 Q82,112 92,116"/>'+          /* hair */

    '<circle cx="96" cy="62" r="2.6"/>'+                       /* bindi dot above */

    '<path d="M96,105 C88,124 90,160 94,196"/>'+               /* body */

    '<path d="M92,122 C74,146 84,176 88,196"/>'+               /* saree drape */

    '<path d="M100,120 C122,116 146,124 162,134"/>'+           /* reaching arm */

    '<path d="M100,132 C120,132 142,140 156,146"/>'+           /* second arm */

    '</g>';

  /* brother, right, arm out */

  s+=g+

    '<circle cx="226" cy="82" r="20"/>'+                       /* head */

    '<path d="M208,72 Q226,60 244,72"/>'+                      /* hair */

    '<path d="M226,102 C236,122 234,160 230,196"/>'+           /* body */

    '<path d="M220,122 C200,126 180,132 168,138"/>'+           /* extended arm to wrist */

    '<path d="M234,124 C250,136 252,166 246,190"/>'+           /* other arm */

    '</g>';

  /* the thread between their hands */

  s+='<path d="M158,140 C164,133 170,146 176,138" fill="none" stroke="'+A+'" stroke-width="3" stroke-linecap="round"/>';

  s+='<circle cx="167" cy="139" r="6" fill="none" stroke="'+A+'" stroke-width="2.6"/>';

  /* his own thing, sitting in the panel */

  s+='<g transform="translate(274,178) scale(1.5)" stroke="'+A+'" stroke-width="1.9" fill="none" stroke-linecap="round" stroke-linejoin="round">'+ICONS[b.art]+'</g>';

  return s;

}



/* ============ wiring ============ */

const $=id=>document.getElementById(id);

const svg=$("svg"), stage=$("stage"), base=$("thread-base"), braid=$("thread-braid");

const HOLD_MS=1900;

let cur=0, p=0, holding=false, tied=false, raf=null, last=0, L=0;



$("fromline").textContent="Raksha Bandhan · from "+FROM;

$("foot1").textContent="— "+FROM;

$("foot2").textContent="— "+FROM;



BROTHERS.forEach((b,i)=>{

  const btn=document.createElement("button");

  btn.className="name-btn";

  btn.innerHTML='<svg viewBox="-130 -130 260 260" width="66" height="66">'+buildRakhi(b)+'</svg>'+b.name;

  btn.onclick=()=>open(i);

  const mini=btn.querySelector("svg");

  requestAnimationFrame(()=>mini.classList.add("s1","s2","s3","s4"));

  $("names").appendChild(btn);

});



function open(i){

  const b=BROTHERS[i]; cur=i; p=0; tied=false; holding=false;

  const r=document.documentElement.style;

  r.setProperty("--accent",b.accent); r.setProperty("--accent2",b.accent2);

  $("whose").textContent=b.name;

  $("scene").innerHTML=buildScene(b);

  $("rakhi").innerHTML=buildRakhi(b);

  stage.classList.remove("tied","s1","s2","s3","s4");

  L=base.getTotalLength();

  [base,braid].forEach(el=>{ el.style.strokeDasharray=L; el.style.strokeDashoffset=L; });

  $("fill").style.transform="scaleX(0)";

  $("hold").classList.remove("gone");

  $("holdtxt").textContent="Hold to tie the rakhi";

  $("hint").textContent="Press and keep holding";

  $("greet").innerHTML=""; $("love").textContent="";

  $("wish").classList.remove("on");

  $("reply").href="https://wa.me/"+MY_NUMBER+"?text="+encodeURIComponent("Rakhi tied \u{1F9F5} thank you "+FROM);

  $("gate").classList.add("hidden"); $("stageWrap").classList.remove("hidden");

  window.scrollTo(0,0);

  last=performance.now(); cancelAnimationFrame(raf); raf=requestAnimationFrame(loop);

}

$("back").onclick=()=>{

  cancelAnimationFrame(raf);

  $("stageWrap").classList.add("hidden"); $("gate").classList.remove("hidden"); window.scrollTo(0,0);

};



const hb=$("hold");

hb.addEventListener("pointerdown",e=>{ e.preventDefault(); holding=true; hb.setPointerCapture(e.pointerId); });

["pointerup","pointercancel","pointerleave"].forEach(ev=>hb.addEventListener(ev,()=>holding=false));

hb.addEventListener("keydown",e=>{ if(e.key===" "||e.key==="Enter"){e.preventDefault();holding=true;} });

hb.addEventListener("keyup",()=>holding=false);



function loop(t){

  raf=requestAnimationFrame(loop);

  const dt=Math.min(t-last,50); last=t;

  if(!tied){

    p += holding ? dt/HOLD_MS : -dt/(HOLD_MS*1.6);

    p = Math.max(0, Math.min(1, p));

    render();

    if(p>=1) finish();

    else if(!holding && p>0) $("hint").textContent="Keep holding — don't let go";

    else if(holding) $("hint").textContent = p<.35 ? "Winding the thread…" : p<.7 ? "The rakhi is opening…" : "Almost tied…";

  }

}

function render(){

  [base,braid].forEach(el=>el.style.strokeDashoffset=L*(1-p));

  $("fill").style.transform="scaleX("+p+")";

  toggle("s1", p>0.04); toggle("s2", p>0.22); toggle("s3", p>0.5); toggle("s4", p>0.78);

}

function toggle(c,on){ stage.classList[on?"add":"remove"](c); }



function finish(){

  tied=true; p=1; render();

  stage.classList.add("tied");

  hb.classList.add("gone"); $("hint").textContent="";

  buzz();

  confetti(BROTHERS[cur]);

  setTimeout(()=>{

    $("greet").innerHTML=GREET(BROTHERS[cur].name);

    $("love").textContent=LOVE;

    $("wish").classList.add("on");

  },600);

}

function buzz(){ try{ navigator.vibrate && navigator.vibrate([18,60,26]); }catch(e){} }



function confetti(b){

  if(window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const c=[b.accent,b.accent2,"#FFD268","#FDF6E8"];

  for(let i=0;i<38;i++){

    const d=document.createElement("div");

    d.className="bit";

    d.style.left=Math.random()*100+"vw";

    d.style.background=c[i%c.length];

    d.style.animation="fall "+(3+Math.random()*2.5)+"s linear "+(Math.random()*1.2)+"s forwards";

    document.body.appendChild(d);

    setTimeout(()=>d.remove(),7200);

  }

}

</script>

