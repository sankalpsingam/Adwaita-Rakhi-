<script>

/* ============ 1. EDIT: you ============ */

const FROM = "Adwaita";

const MY_NUMBER = "61400000000";       // your WhatsApp number: country code, no + or spaces



/* ============ 2. EDIT: the words ============ */

const GREET = n => "Happy Raksha Bandhan,<br><i>" + n + "</i>";

const LOVE  = "Love you deeply. Always there for you.";



/* ============ 3. EDIT: your brothers ============ */

/* each one gets his own colours and his own petal shape */

const BROTHERS = [

  {name:"Bhushan",    art:"steth",  accent:"#F2A03D", accent2:"#D2452F", petals:10, shape:"lotus"},

  {name:"Yash",       art:"flask",  accent:"#7FD8C8", accent2:"#1F7A6B", petals:8,  shape:"round"},

  {name:"Chirag",     art:"car",    accent:"#C6B2F5", accent2:"#5B3FBF", petals:12, shape:"point"},

  {name:"Mohit",      art:"tennis", accent:"#F5C542", accent2:"#B0451F", petals:6,  shape:"lotus"},

  {name:"Prathamesh", art:"pad",    accent:"#F7A9C4", accent2:"#B3255F", petals:10, shape:"tear"},

  {name:"Krishna",    art:"drum",   accent:"#9FD98A", accent2:"#2F7C4F", petals:8,  shape:"point"}

];



/* line-art icons, drawn to sit in a 34 x 34 box around 0,0 */

const ICONS = {

  steth:'<path d="M-10,-15 L-10,-9 A10,10 0 0 0 6,-9 L6,-15"/><path d="M-2,-1 L-2,5 A5,5 0 0 0 7,8"/><circle cx="9" cy="11" r="4.5"/><circle cx="-10" cy="-16" r="1.8"/><circle cx="6" cy="-16" r="1.8"/>',

  flask:'<path d="M-6,-15 L-6,-5 L-12,8 A5,5 0 0 0 -7,15 L7,15 A5,5 0 0 0 12,8 L6,-5 L6,-15"/><path d="M-8,-15 L8,-15"/><path d="M-9,4 L9,4"/><circle cx="-2" cy="9" r="1.7"/><circle cx="4" cy="11" r="1.2"/>',

  car:'<path d="M-15,5 Q-13,-2 -6,-3 L-2,-9 Q2,-12 7,-9 L11,-3 Q16,-2 16,5"/><path d="M-15,5 L16,5"/><path d="M-1,-3 L0,-9"/><circle cx="-8" cy="8" r="4"/><circle cx="9" cy="8" r="4"/>',

  tennis:'<g transform="rotate(-28)"><ellipse cx="-1" cy="-6" rx="9" ry="11"/><path d="M-1,-17 L-1,5 M-10,-6 L8,-6"/><path d="M-1,5 L-1,15"/></g><circle cx="9" cy="10" r="5"/><path d="M4.5,7.5 Q9,10 4.5,12.5"/>',

